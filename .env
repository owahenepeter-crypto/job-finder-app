# Database
DATABASE_URL=mongodb://localhost:27017/job-finder
MONGO_DB_NAME=job-finder

# API Server
API_PORT=5000
API_HOST=localhost
NODE_ENV=development

# JWT Authentication
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRY=7d

# WhatsApp Integration
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_BUSINESS_PHONE_ID=dev_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=dev_account_id
WHATSAPP_API_TOKEN=dev_token

# Firebase
FIREBASE_API_KEY=dev_api_key
FIREBASE_AUTH_DOMAIN=job-finder-dev.firebaseapp.com
FIREBASE_PROJECT_ID=job-finder-dev
FIREBASE_STORAGE_BUCKET=job-finder-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=dev_sender_id
FIREBASE_APP_ID=dev_app_id

# Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=dev_email
SMTP_PASSWORD=dev_password

# App Settings
APP_NAME=Job Finder
APP_VERSION=1.0.0
CONTACT_PHONE=+233XXXXXXXXX
